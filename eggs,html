        let holdTimeout;
        let holdInterval;
        let timerInterval = null;

        function init() {
            renderDonenessSelector();
            updateCalculation();
            lucide.createIcons();
            
            // 🌟 初始化兩層圈圈的長度
            const circumference = 64 * 2 * Math.PI;
            document.getElementById('progress-ring').style.strokeDasharray = `${circumference} ${circumference}`;
            document.getElementById('overtime-ring').style.strokeDasharray = `${circumference} ${circumference}`;
            document.getElementById('overtime-ring').style.strokeDashoffset = circumference; 
            
            setupHoldButtons(); 
            renderTips(STATE.doneness); 
        }

        function renderDonenessSelector() {
            const container = document.getElementById('doneness-container');
            container.innerHTML = DONENESS_DATA.map((opt, idx) => `
                <div onclick="selectDoneness(${idx})" class="flex flex-col items-center gap-2 cursor-pointer transition-all duration-300">
                    <img src="${opt.img}" alt="${opt.title}" class="egg-figure-preview ${idx === STATE.doneness ? 'selected-egg' : 'opacity-50 grayscale-[0.2]'}">
                    <div class="w-1.5 h-1.5 bg-yolk rounded-full transition-opacity duration-300 ${idx === STATE.doneness ? 'opacity-100' : 'opacity-0'}"></div>
                </div>
            `).join('');
        }

        window.selectDoneness = (idx) => {
            if (STATE.running) return;
            playClickSound(); 
            STATE.doneness = idx;
            renderDonenessSelector();
            updateCalculation();
            renderTips(idx);
        };

        function calculateTime() {
            let time = BASE_TIMES[STATE.doneness];
            if (STATE.temp === 'room') time -= 60;
            if (STATE.size === 's') time -= 30;
            if (STATE.size === 'l') time += 30;
            const wattageFactor = 2000 / STATE.wattage;
            return Math.max(Math.round(time * wattageFactor), 60);
        }

        // ==========================================
        // 🎨 【大廚的調色盤】 🎨
        // 大廚教你改顏色：把下面括號裡的 HEX 色碼換掉，或者自己繼續往下加逗號跟色碼！
        // 系統已經升級成「無限輪迴」，加滿幾百個都沒問題！
        // ==========================================
        const COOL_BLUE_PALETTE = [
            '#60A5FA', // 第1圈 淺藍
            '#3B82F6', // 第2圈 藍
            '#38b6ff', // 第3圈 較深藍
            '#0081cc', // 第4圈 深藍
            '#004aad', // 第5圈 極深藍
            '#00357aA', // 第6圈 墨藍
            '#00167a', // 第7圈 灰黑藍
            '#001da2', // 第8圈 漆黑藍
            '#0025cc', // 第9圈 純黑
            '#1f48ff'  // 第10圈 灰
        ];
        
        const HOT_RED_PALETTE = [
            '#FFB300', // 第1圈 黃
            '#F97316', // 第2圈 橘
            '#f97316', // 第3圈 深橘
            '#f94c16', // 第4圈 紅
            '#ff675d', // 第5圈 深紅
            '#ff8862', // 第6圈 栗紅
            '#ffcb50', // 第7圈 焦紅
            '#fd8d1a', // 第8圈 褐黑紅
            '#ff3d00', // 第9圈 純黑
            '#b60606'  // 第10圈 灰（以上全部的顔色注解全部都不對的，我懶得改了）
        ];

        function getColor(lap) {
            if (lap === 1 && !STATE.iceWaterMode) {
                if (STATE.timeLeft <= 10 && STATE.running) return '#EF4444'; 
                if (STATE.timeLeft <= 60 && STATE.running) return '#F97316'; 
                return '#FFB300'; 
            }
            if (lap === 1 && STATE.iceWaterMode) {
                if (STATE.timeLeft <= 10 && STATE.running) return '#3730A3'; 
                return '#60A5FA'; 
            }
            const palette = STATE.iceWaterMode ? COOL_BLUE_PALETTE : HOT_RED_PALETTE;
            // 🌟 核心魔術：使用 % 符號讓顏色陣列無限輪迴！
            const idx = (lap - 1) % palette.length;
            return palette[idx];
        }

        function updateTimerDisplay() {
            const m = Math.floor(STATE.timeLeft / 60).toString().padStart(2, '0');
            const s = (STATE.timeLeft % 60).toString().padStart(2, '0');
            const timerDisplay = document.getElementById('timer-display');
            timerDisplay.innerText = `${m}:${s}`;
            
            const circumference = 64 * 2 * Math.PI;
            const baseRing = document.getElementById('progress-ring');
            const overRing = document.getElementById('overtime-ring');

            let totalLaps = 1;
            if (STATE.timeLeft > 0) {
                totalLaps = Math.ceil(STATE.timeLeft / STATE.totalTime);
            }
            if (totalLaps < 1) totalLaps = 1;

            let remainder = STATE.timeLeft % STATE.totalTime;
            let progress = remainder === 0 ? 1 : remainder / STATE.totalTime;

            // 🌟 抓到你了！就是這裡引發「往回跳 Glitch」！
            // 當圈數發生變化時，我們先把它標記下來
            const isLapChange = STATE.lastLap !== undefined && STATE.lastLap !== totalLaps;
            STATE.lastLap = totalLaps;

            // 【第一步】如果圈數變了，瞬間「拔掉」動畫！
            if (isLapChange) {
                overRing.style.transition = 'none';
                baseRing.style.transition = 'none';
            }

            // 【第二步】給予新的進度長度和顏色
            if (totalLaps === 1) {
                baseRing.style.strokeDashoffset = circumference - progress * circumference;
                baseRing.style.color = getColor(1);
                overRing.style.opacity = '0'; 
                overRing.style.strokeDashoffset = circumference; 
                timerDisplay.style.color = getColor(1);
            } else {
                baseRing.style.strokeDashoffset = 0; // 底層永遠是滿的
                baseRing.style.color = getColor(totalLaps - 1);
                overRing.style.strokeDashoffset = circumference - progress * circumference; // 頂層剝落
                overRing.style.color = getColor(totalLaps);
                overRing.style.opacity = '1';
                timerDisplay.style.color = getColor(totalLaps);
            }

            // 【第三步】強制瀏覽器結算畫面，然後再把動畫「插回去」！
            if (isLapChange) {
                // 這個 void offsetWidth 就是前端大廚的祖傳秘方「強制重繪 (Reflow)」
                void overRing.offsetWidth; 
                // 立刻把動畫還給它，這樣之後的每一秒倒數才會繼續絲滑
                overRing.style.transition = 'stroke-dashoffset 0.2s linear, opacity 0.3s ease, color 0.3s ease';
                baseRing.style.transition = 'stroke-dashoffset 0.2s linear, color 0.3s ease';
            } else {
                // 如果沒有換圈，就確保動畫是一直開著的
                overRing.style.transition = 'stroke-dashoffset 0.2s linear, opacity 0.3s ease, color 0.3s ease';
                baseRing.style.transition = 'stroke-dashoffset 0.2s linear, color 0.3s ease';
            }
        }

        function updateCalculation() {
            if (STATE.running) return;
            const time = calculateTime();
            STATE.totalTime = time; 
            STATE.timeLeft = time;
            updateTimerDisplay();
            
            const d = DONENESS_DATA[STATE.doneness];
            document.getElementById('timer-status').innerText = d.action;
            document.getElementById('doneness-big-title').innerText = d.title;
            document.getElementById('doneness-big-title').style.color = d.color;
            document.getElementById('doneness-sub-desc').innerText = d.desc;
        }

        window.adjustTime = (seconds) => {
            if (!STATE.running) return;
            STATE.timeLeft += seconds;
            if (STATE.timeLeft < 1) STATE.timeLeft = 1; 
            updateTimerDisplay(); 
        };

        function setupHoldButtons() {
            const btnMinus = document.getElementById('btn-minus');
            const btnPlus = document.getElementById('btn-plus');

            function startAdjusting(amount) {
                if (!STATE.running) return;
                playClickSound(); 
                adjustTime(amount); 
                holdTimeout = setTimeout(() => {
                    holdInterval = setInterval(() => { adjustTime(amount); }, 100); 
                }, 400); 
            }

            function stopAdjusting() {
                clearTimeout(holdTimeout);
                clearInterval(holdInterval);
            }

            const addHoldListeners = (btn, amount) => {
                btn.addEventListener('mousedown', (e) => { if(e.button === 0 && !btn.disabled) startAdjusting(amount); });
                btn.addEventListener('touchstart', (e) => { e.preventDefault(); if(!btn.disabled) startAdjusting(amount); }, {passive: false});
                btn.addEventListener('mouseup', stopAdjusting);
                btn.addEventListener('mouseleave', stopAdjusting);
                btn.addEventListener('touchend', (e) => { e.preventDefault(); stopAdjusting(); }, {passive: false});
                btn.addEventListener('touchcancel', stopAdjusting);
            };

            addHoldListeners(btnMinus, -10);
            addHoldListeners(btnPlus, 10);
        }

        window.playRecipeVideo = () => {
            playClickSound(); 
            const title = document.getElementById('detail-title').innerText;
            const recipe = RECIPES.find(r => r.title === title);

            if (recipe && recipe.youtubeId) {
                const container = document.getElementById('video-player-container');
                const contentArea = document.getElementById('video-content-area');
                document.getElementById('video-player-title').innerText = `正在播放：${title}`;
                contentArea.innerHTML = `<iframe class="w-full h-full rounded-2xl shadow-2xl" src="https://www.youtube.com/embed/${recipe.youtubeId}?enablejsapi=1&rel=0" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
                container.classList.remove('hidden'); container.classList.add('flex');
            } else if (recipe) {
                playFakeVideo(recipe);
            }
        };

        window.closeVideoPlayer = () => {
            playClickSound(); 
            const container = document.getElementById('video-player-container');
            document.getElementById('video-content-area').innerHTML = ""; 
            container.classList.add('hidden'); container.classList.remove('flex');
        };

        function playFakeVideo(recipe) {
            const player = document.getElementById('fake-video-player');
            document.getElementById('fake-video-thumb').src = recipe.image;
            document.getElementById('fake-video-title').innerText = recipe.title;
