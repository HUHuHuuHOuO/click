            history.innerHTML += `<div class="mt-2 text-right"><span class="bg-yolk/10 p-2 rounded-lg inline-block text-gray-800"><b>你：</b>${q}</span></div>`;
            input.value = '';

            if (q.includes("切換阿嫲") || q.includes("阿嫲模式") || q.includes("阿嬤模式")) {
                currentMode = "grandma";
                if (q.length <= 8) {
