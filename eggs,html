                }
            }

            const tiredKeywords = ["好累", "太累", "辛苦", "不想努力", "好攰", "心累"];
            if (tiredKeywords.some(keyword => q.includes(keyword))) {
                const comfortText = currentMode === "grandma" 
                    ? "生活太累沒關係，給自己休息一下，不要太累，身體第一喔！阿嫲疼你！❤️"
