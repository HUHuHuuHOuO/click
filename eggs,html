                const aiName = currentMode === "grandma" ? "阿嫲" : "大廚";
                history.innerHTML += `<div class="mt-2 text-yolk"><b>${aiName}：</b><span class="text-gray-700">${comfortText}</span></div>`;
                history.scrollTop = history.scrollHeight;
                return; 
            }

            if (q.includes("廣東話") || q.includes("粵語")) { currentLanguage = "yue"; } 
            else if (q.includes("台語") || q.includes("臺語") || q.includes("閩南語")) { currentLanguage = "tw"; } 
            else if (q.includes("國語") || q.includes("中文") || q.includes("普通話")) { currentLanguage = "default"; }
            
            const loadingId = 'loading-' + Date.now();
            const aiName = currentMode === "grandma" ? "阿嫲" : "大廚";
            const thinkingArray = currentMode === "grandma" ? thinkingSentencesGrandma : thinkingSentencesChef;

            history.innerHTML += `<div id="${loadingId}" class="mt-2 text-yolk"><b>${aiName}：</b><span class="text-gray-700">${thinkingArray[0]}</span></div>`;
            history.scrollTop = history.scrollHeight;

            const currentRecipe = document.getElementById('detail-title').innerText;
            const textSpan = document.getElementById(loadingId).querySelector('span');

            let sentenceIndex = 0;
            const thinkingInterval = setInterval(() => {
                sentenceIndex = (sentenceIndex + 1) % thinkingArray.length;
                textSpan.innerText = thinkingArray[sentenceIndex];
            }, 1500);

            let systemContent = "";
            if (currentMode === "grandma") {
                systemContent = "你是一位精通蛋料理的五星級大廚，但你現在的靈魂是一位非常疼愛後輩的鄉下老阿嬤。如果你被要求講笑話，請講一個跟食物有關的冷笑話。";
